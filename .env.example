# Copia questo file in ".env" e inserisci i tuoi valori.
# Il file .env NON va caricato su GitHub (e' nel .gitignore).

# Porta del server
PORT=3000

# Database MySQL
DB_NAME=taskflow
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost

# JWT: chiave segreta per firmare i token e durata del token
JWT_SECRET=cambia-questa-chiave-con-una-lunga-e-casuale
JWT_EXPIRES_IN=1d

# Account amministratore creato con "npm run seed"
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@taskflow.it
ADMIN_PASSWORD=admin12345
